{
  "name": "smm-bot",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node bot.js",
    "scan": "node cli.js scan",
    "scan:dry": "node cli.js scan --dry",
    "status": "node cli.js status",
