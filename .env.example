# === Обязательные ===
GEMINI_API_KEY=your_gemini_key
GROQ_API_KEY=your_groq_key

# Telegram уведомления
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-1001234567890

# === Медиа ===
MEDIA_DIR=/var/www/smm-media
MEDIA_PUBLIC_URL=https://smm.coucou-events.com/media

# === Интервалы (минуты) ===
SCAN_INTERVAL_MIN=15
SCHEDULER_INTERVAL_MIN=1

# === Лимиты ===
LIMIT_GROQ_TOKENS_DAY=200000
LIMIT_GROQ_TOKENS_MONTH=3000000
LIMIT_GEMINI_REQ_DAY=1500
LIMIT_GEMINI_REQ_MONTH=30000
LIMIT_POSTS_DAY=20
LIMIT_POSTS_MONTH=600

# === Модели (опционально) ===
GEMINI_VISION_MODEL=gemini-2.0-flash
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview
GROQ_CAPTION_MODEL=llama-3.3-70b-versatile

# === Очередь ===
# json   — файл data/queue.json (по умолчанию)
# sqlite — БД data/queue.db (better-sqlite3, WAL)
QUEUE_BACKEND=json

# === HTTP health endpoint ===
# Порт для /health /status /metrics. 0 или off — отключить.
HEALTH_PORT=3000

# === Telegram ingest bot (приём фото в inbox) ===
# Токен бота от @BotFather. Должен отличаться от TELEGRAM_BOT_TOKEN (уведомления).
TELEGRAM_INGEST_BOT_TOKEN=

# Whitelist user_id (через запятую). Пусто = любой может прислать (только для dev).
TELEGRAM_INGEST_USERS=

# Дефолтный проект, если в чате не выбран /project и нет #slug в подписи.
TELEGRAM_INGEST_DEFAULT_PROJECT=coucou-events

# ─── Outreach (партнёрский модуль) ─────────────────────────
# Google Places API (searchText) для поиска площадок/агентств
# Получить: console.cloud.google.com → APIs → Places API (New) → Credentials
GOOGLE_PLACES_API_KEY=

# Модель для генерации черновиков outreach (через Groq)
OUTREACH_MODEL=openai/gpt-oss-120b

# Куда присылать сводки outreach (если хотите отдельно от аналитики)
# ANALYTICS_BOT_TOKEN и ANALYTICS_CHAT_ID уже используются для SMM

# ─── 2GIS Catalog API (бесплатный демо-ключ) ────────────────
# Получить: platform.2gis.ru/ru/keys
# ВАЖНО: демо-тариф НЕ отдаёт contact_groups (только name/address/id/type).
# Контакты добираются через outreach-cli enrich (OSM) или вручную.
# Покрытие: Армения, Грузия, Казахстан, Узбекистан, ОАЭ, Катар, Чехия, Монголия.
# НЕ покрывает: Бали, Дананг, Нячанг, Барселона, Пхукет.
TWOGIS_API_KEY=

# ─── Orchestrator (единый процесс bot.js) ──────────────────
# Все подсистемы в одном node-процессе. Отдельный PM2 supplier-bot больше не нужен.
ENABLE_SMM=1
ENABLE_SUPPLIER_BOT=1
ENABLE_OUTREACH=1

# Supplier bot (Telegram поиск по локальной базе suppliers/)
SUPPLIER_BOT_TOKEN=
SUPPLIER_BOT_USERS=
SUPPLIER_BOT_DEFAULT_PROJECT=coucou-events

# Outreach daily summary (cron expression, по умолчанию 09:00)
OUTREACH_SUMMARY_CRON=0 9 * * *
# Разовый tick при старте (обычно off, чтобы не спамить)
OUTREACH_TICK_ON_START=0
